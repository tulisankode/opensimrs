{
  "name": "@opensimrs/model-sdk",
  "version": "1.2.0",
  "private": true,
  "description": "Model Sequelize/Mongoose bersama untuk layanan OpenSIMRS",
  "type": "module",
  "main": "syncronize.js",
  "exports": {
    "./instance": {
      "import": "./configurations/config-db.js"
    },
    "./builder": {
      "import": "./configurations/sequelize-instance.js"
    },
    "./datamaster": {
      "import": "./exports/datamaster-exports.js"
    },
    "./rekam-medis": {
      "import": "./exports/rekam-medis-exports.js"
    },
    "./farmasi": {
      "import": "./exports/farmasi-exports.js"
