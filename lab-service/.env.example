DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=exampel
DB_PASSWORD=
DB_USERNAME=

# API CONFIG
API_BASE="api"
API_VERSION="v3"


# Application config
APPLICATION_PORT=4444
APPLICATION_HOST=127.0.0.1

# API URL
REKAM_MEDIS_URL=
# Bridging LIS (adamLIS)
# Kunci enkripsi API key & kunci masuk LIS di database (bawaan: SECRET_KEY). Jangan diganti setelah data tersimpan.
LIS_KUNCI_RAHASIA=
# nyata = memanggil LIS; mock = respons registrasi tiruan (pengujian)
LIS_MODE=nyata
LIS_TIMEOUT_MS=15000
