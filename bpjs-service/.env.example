# Port layanan
APPLICATION_PORT=8098
# Sama dengan SECRET_KEY auth-service (verifikasi token JWT HS256)
SECRET_KEY=
# Kunci enkripsi rahasia BPJS di database (bawaan: SECRET_KEY). Jangan diganti setelah data tersimpan.
BPJS_KUNCI_RAHASIA=

# PostgreSQL & MongoDB OpenSIMRS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_NAME=opensimrs
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
MONGO_DB_AUTH_SOURCE=admin

# BPJS
# nyata = memanggil BPJS; mock = respons tiruan terenkripsi (pengujian)
BPJS_MODE=nyata
# development (apijkn-dev) | production (apijkn)
BPJS_LINGKUNGAN=development
# Kredensial PCare & VClaim diisi per faskes di Setting › Konfigurasi Integrasi (disimpan terenkripsi)
# Rencana Kontrol & SPRI VClaim (STD-0021): jalur & payload belum diverifikasi ke katalog resmi BPJS. Di luar mode
# mock, operasi surat ditolak sampai diisi true setelah diverifikasi di sandbox BPJS.
BPJS_VCLAIM_RENKON_DIKONFIRMASI=false
# Alamat setting-service untuk memeriksa fitur faskes (fail-closed: tak terjangkau = ditolak)
SETTING_SERVICE_URL=http://localhost:8094

# Pengiriman otomatis pendaftaran & kunjungan PCare
BPJS_PEKERJA=true
BPJS_INTERVAL_MENIT=10
BPJS_RENTANG_HARI=3
BPJS_MAKS_PERCOBAAN=5

# Catatan jaringan: API BPJS & SATUSEHAT hanya menerima IP Indonesia.
