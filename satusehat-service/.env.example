# Port layanan
APPLICATION_PORT=8097
# Sama dengan SECRET_KEY auth-service (verifikasi token JWT HS256)
SECRET_KEY=

# PostgreSQL & MongoDB OpenSIMRS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_NAME=opensimrs
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=
MONGO_DB_AUTH_SOURCE=admin

# SATUSEHAT
# nyata = memanggil Kemenkes; mock = respons tiruan (pengujian, tidak menulis ID ke database)
SATUSEHAT_MODE=nyata
# sandbox (api-satusehat-stg.dto.kemkes.go.id) | produksi (api-satusehat.kemkes.go.id)
SATUSEHAT_LINGKUNGAN=sandbox
# Kredensial (Client ID/Secret, Organization ID) diisi per faskes di Setting › Konfigurasi Integrasi

# Pengiriman otomatis kunjungan yang sudah selesai
SATUSEHAT_PEKERJA=true
SATUSEHAT_INTERVAL_MENIT=15
SATUSEHAT_RENTANG_HARI=7
SATUSEHAT_MAKS_PERCOBAAN=5
