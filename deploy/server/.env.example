# Templat .env server OpenSIMRS. File asli disimpan DI SERVER pada ~/.opensimrs/.env (bukan di repo);
# deploy.sh menyalinnya ke .env root. Alamat antar-layanan diatur oleh docker-compose.server.yml.
API_BASE=api
API_VERSION=v3
APPLICATION_HOST=0.0.0.0
APPLICATION_MODULE=

DB_DIALECT=postgres
DB_NAME=opensimrs
DB_USERNAME=opensimrs
DB_PASSWORD=

MONGO_INITDB_DATABASE=opensimrs
MONGO_DB_NAME=opensimrs
MONGO_DB_AUTH_SOURCE=admin
MONGO_DB_USERNAME=opensimrs
MONGO_DB_PASSWORD=

REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# Rahasia aplikasi (wajib diisi, nilai acak panjang: openssl rand -hex 32; samakan antar layanan)
SECRET_KEY=
API_KEY_SECRET=
API_KEY_CHECK_NORM=
ADMISI_SECRET_KEY=
ANTRIAN_KEY_SECRET=

# Opsional: buat akun admin saat deploy (lihat database/seeders)
SEED_ADMIN_PASSWORD=
# Username akun admin yang dibuat seeder (default: admin)
SEED_ADMIN_USERNAME=

# Alamat API untuk browser (frontend dibangun dengan nilai ini). Kosong = http://SERVER_HOST:8080
PUBLIC_API_URL=https://api.simrs.contoh.id
# Host yang boleh mengakses frontend (vite preview.allowedHosts), dipisah koma
FRONTEND_ALLOWED_HOSTS=simrs.contoh.id
