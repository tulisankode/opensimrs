# SIMRS Studio (mode pengembang berbasis AI). Rancangan: docs/rancangan/STUDIO-PENGEMBANG.md
# Layanan ini dijalankan LANGSUNG di mesin pengembang (bukan kontainer) karena memanggil Claude Code CLI
# yang sudah login dengan langganan Anda (`claude` → /login), dan mengubah berkas di repo ini.

# Port layanan
APPLICATION_PORT=8090
# Sama dengan SECRET_KEY auth-service (verifikasi token JWT HS256)
SECRET_KEY=

# PostgreSQL OpenSIMRS (database bersama)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Kunci instalasi (mati bawaan): isi "aktif" untuk membuka Studio di mesin pengembang/staging. Tanpa itu semua endpoint
# Studio menolak (503), walau superadmin menyalakan Mode Pengembang.
STUDIO_PENGEMBANG=
# development | staging | production. Pada production, coding/QA/rilis ditolak.
LINGKUNGAN=development

# Repo yang dikembangkan (bawaan: folder induk layanan ini) & perintah Claude Code CLI.
# STUDIO_REPO_DIR=
# STUDIO_CLAUDE_BIN=claude

# Kunci enkripsi rahasia Studio (kunci API konektor, token Git, kunci privat ekstensi). Bawaan: SECRET_KEY.
# STUDIO_KUNCI_RAHASIA=
# Runtime ekstensi tanpa kode (validasi/pratinjau/pasang).
# BASE_URL_API_LAPORAN=http://localhost:8088/api/v3/laporan
