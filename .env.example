# Templat .env root OpenSIMRS. Salin ke .env lalu isi; JANGAN commit .env.
# Dipakai oleh docker compose, migrasi (npm run db:migrate), dan skrip data demo (npm run db:demo:*).
# Panduan lengkap & .env per layanan: docs/INSTALLATION_GUIDE.md

# DATABASE CONFIGURATION (PostgreSQL)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=opensimrs
DB_USERNAME=
DB_PASSWORD=
# Contoh DB_POOL: {"acquire": 30000, "max": 10, "min": 0, "idle": 10000}
DB_POOL=

# REDIS CONFIGURATION
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# MONGODB CONFIGURATION
MONGO_INITDB_DATABASE=opensimrs
MONGO_DB_NAME=opensimrs
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_AUTH_SOURCE=admin
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

# JWT HS256: SECRET_KEY wajib sama di semua layanan. PRIVATE_KEY/PUBLIC_KEY dikosongkan.
SECRET_KEY=
PRIVATE_KEY=
PUBLIC_KEY=

# Kata sandi akun data demo (bawaan Demo@2026 bila kosong)
DEMO_PASSWORD=

# ADMISI SERVICE CONFIGURATION
DATAMASTER_SERVICE_URL=http://localhost:8096
# Kunci API aplikasi mobile; isi acak: openssl rand -hex 32
API_KEY_CHECK_NORM=

# ANTRIAN SERVICE CONFIGURATION
ADMISI_API_URL=http://localhost:8081/api/v3/admisi
ADMISI_SECRET_KEY=
ANTRIAN_KEY_SECRET=

# FARMASI & STOK FARMASI SERVICE CONFIGURATION
REKAM_MEDIS_URL=http://localhost:8093/api/v3
INVENTORY_URL=http://localhost:8086/api/v3
API_KEY_SECRET=

# FRONTEND (lokal: tulis di frontend-service/.env; lihat docs/INSTALLATION_GUIDE.md bagian 5.3)
VITE_BASE_URL=
VITE_BASE_AUTH=
VITE_URL_SETTING=
VITE_BASE_DATAMASTER=
VITE_BASE_PEMBAYARAN=
VITE_BASE_LABORATORIUM=
VITE_BASE_ADMISI=
VITE_BASE_IGD=
VITE_BASE_FARMASI=
VITE_BASE_RAWAT_JALAN=
VITE_BASE_REKAM_MEDIS=
VITE_BASE_RAWAT_INAP=
VITE_BASE_INVENTORY=
VITE_BASE_DASHBOARD=
VITE_BASE_ANTRIAN=
VITE_BASE_STOK=
VITE_BASE_SATUSEHAT=
VITE_BASE_BPJS=
VITE_BASE_PENUNJANG=
