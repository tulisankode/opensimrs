# Laboratorium PK (order lab otomatis peserta MCU) & Admisi (pasien baru dari impor rombongan MCU)
BASE_URL_API_LAB=http://localhost:8087/api/v3/lab
BASE_URL_API_ADMISI=http://localhost:8081/api/v3/admisi
