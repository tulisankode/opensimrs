DB_NAME=opensimrs
DB_HOST="localhost"
DB_USERNAME=
DB_PASSWORD=
DB_DIALECT="postgres"
BASE_URL="0.0.0.0"

# API CONFIG
API_BASE="api"
API_VERSION="v3"


# Application config
APPLICATION_PORT=8081
APPLICATION_HOST=0.0.0.0

# Helpdesk asisten pengguna (OpenClaw Gateway di VM terpisah; docs/rancangan/HELPDESK-OPENCLAW.md).
# Disarankan diatur dari Setting › Konfigurasi Integrasi › Helpdesk AI (token terenkripsi di DB); nilai di sini hanya
# dipakai selama pengaturan itu belum disimpan. Token memberi akses operator penuh ke Gateway: jangan dibagikan.
# HELPDESK_KUNCI_RAHASIA=   (opsional; kunci enkripsi token, bawaan SECRET_KEY)
HELPDESK_GATEWAY_URL=
HELPDESK_GATEWAY_TOKEN=
# HELPDESK_AGEN=helpdesk-opensimrs
# HELPDESK_BATAS_PER_JAM=20
# HELPDESK_TIMEOUT_DETIK=120
