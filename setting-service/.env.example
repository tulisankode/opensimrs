# API CONFIG
API_BASE="api"
API_VERSION="v3"


# Application config
APPLICATION_PORT=8081
APPLICATION_HOST=0.0.0.0

# Helpdesk asisten pengguna (OpenClaw Gateway di VM terpisah; docs/rancangan/HELPDESK-OPENCLAW.md).
# Kosong = tombol Bantuan tidak tampil. Token memberi akses operator penuh ke Gateway: jangan dibagikan.
HELPDESK_GATEWAY_URL=
HELPDESK_GATEWAY_TOKEN=
